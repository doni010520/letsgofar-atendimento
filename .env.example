# Copie para .env.local e preencha. NUNCA comite valores reais.
# Em produção estas variáveis ficam no EasyPanel (serviço letsgofar-atendimento).

# Públicas por design — vão para o bundle do navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDOS — nunca versionar.
SUPABASE_SERVICE_ROLE_KEY=   # ignora RLS por completo
SUPABASE_DB_URL=             # só para rodar migrations
CRON_SECRET=
UAZAPI_HOST=https://benitechlab.uazapi.com
UAZAPI_ADMIN_TOKEN=          # conta uazapi INTEIRA, compartilhada com outros clientes
UAZAPI_WEBHOOK_TOKEN=
OPENAI_API_KEY=
RESEND_API_KEY=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_ID=
META_WABA_ID=
META_GRAPH_VERSION=v23.0

APP_BASE_URL=https://SEU-DOMINIO   # domínio público real; com localhost nenhuma mensagem chega
CRON_INTERVAL_MS=60000
MFA_EXEMPT_EMAILS=
CONTRACT_MAILER_FROM=
NODE_ENV=production
